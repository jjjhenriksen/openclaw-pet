{
  "name": "openclaw-plugin-openclaw-pet",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:overlay",
    "build:overlay": "node ./scripts/build-overlay.mjs",
    "test": "vitest run --config ./vitest.config.ts",
    "pack:check": "node ./scripts/check-package.mjs",
    "validate": "npm run build && npm test && npm run pack:check",
    "smoke:macos": "node ./scripts/smoke-macos.mjs"
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "dist/pet-overlay-macos",
    "dist/pet-overlay-win.exe",
    "openclaw.plugin.json",
    "README.md",
    "VERIFICATION.md",
    "overlay/pet-overlay.swift",
    "overlay/windows/OpenClawPetOverlay.csproj",
    "overlay/windows/Program.cs"
  ],
  "peerDependencies": {
    "openclaw": "2026.9.1"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "openclaw": "2026.9.1",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1"
}
